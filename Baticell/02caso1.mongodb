use("baticell_store")
db.clients.find(
    {
      "direccion": { $nin: [/Breña/, /La Molina/] }
    },
    {
      "nombre": 1,
      "apellidos": 1,
      "email": 1,
      "puntos": 1,
      "_id": 0
    }
  ).sort({ "apellidos": -1 }) 
