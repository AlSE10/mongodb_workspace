use("UrbanStyle_store")

//lista los productos cuya cantidad y precio sea mayor o ugual que 100$and valida que dos expreciones sean verdaderas

db.products.find(
    {
        $and:[{cantidad: {$gte:100},
                precio:{$lte:100}}]
    },
    {
        _id:0,
        nombre:1,
        cantidad:1,
        precio:1
    }
)
